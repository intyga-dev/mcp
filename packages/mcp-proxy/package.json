{
  "name": "@intyga/mcp-proxy",
  "version": "1.0.0",
  "description": "Stdio proxy that gates a third-party MCP server's tool calls behind a signed human approval — no code changes to the wrapped server.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intyga-dev/mcp.git",
    "directory": "packages/mcp-proxy"
  },
  "homepage": "https://www.intyga.com",
  "bugs": "https://github.com/intyga-dev/mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "authorization",
    "human-approval",
    "proxy"
  ],
  "type": "module",
  "files": [
    "src/cli.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "intyga-proxy": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-lines=98 --test-coverage-branches=98 --test-coverage-functions=98 'src/**/*.test.ts'"
  },
  "devDependencies": {
    "@intyga/config": "workspace:*",
    "@types/node": "^26.4.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@intyga/mcp-sdk": "workspace:*"
  }
}
