{
  "name": "@intyga/mcp-proxy",
  "version": "3.1.1",
  "description": "Stdio proxy that gates a third-party MCP server's tool calls behind a signed human approval \u2014 no code changes to the wrapped server.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intyga-dev/mcp.git",
    "directory": "packages/mcp-proxy"
  },
  "homepage": "https://www.intyga.com",
  "bugs": "https://github.com/intyga-dev/mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "authorization",
    "human-approval",
    "proxy"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "intyga-proxy": "./dist/cli.js"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test 'src/**/*.test.ts'",
    "test:coverage": "pnpm build && node --test scripts/union-coverage.test.mjs && node scripts/run-coverage.mjs"
  },
  "devDependencies": {
    "@intyga/config": "workspace:*",
    "@intyga/mcp-schemas": "workspace:*",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@intyga/mcp-sdk": "workspace:^"
  }
}
