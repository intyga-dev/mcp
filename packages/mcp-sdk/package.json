{
  "name": "@intyga/mcp-sdk",
  "version": "1.0.0",
  "description": "Wrap an MCP server so every tool call is gated behind a cryptographically-signed human approval (local policy + Intyga gateway step-up).",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intyga-dev/mcp.git",
    "directory": "packages/mcp-sdk"
  },
  "homepage": "https://www.intyga.com",
  "bugs": "https://github.com/intyga-dev/mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "ai-agents",
    "authorization",
    "human-approval",
    "webauthn"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "simulate": "tsx src/simulate.ts",
    "test": "tsx --test 'src/**/*.test.ts'",
    "test:coverage": "tsx --test --experimental-test-coverage --test-coverage-lines=97 --test-coverage-branches=94 --test-coverage-functions=91 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@intyga/config": "workspace:*",
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
